{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/fersandovalgtz/cahita-historico-digital/schemas/irregular-verb.schema.json",
  "title":"CHD historical irregular verb entry",
  "description":"Structured representation of verbs grouped by ALC1737 under VERBOS IRREGULARES. The source's paradigm restrictions and labels are preserved without silently regularizing forms.",
  "type":"object",
  "required":["id","sourceId","part","ruleNumberRaw","sourcePagesDigital","lemmaFormsRaw","sourceGlossRaw","sourceDescription","reviewStatus","humanVerified","provenance"],
  "properties":{
    "id":{"type":"string","pattern":"^ALC1737-iv-[0-9]{4}$"},
    "sourceId":{"const":"ALC1737"},
    "part":{"const":"part_iii"},
    "ruleNumberRaw":{"type":"string"},
    "sourcePagesDigital":{"type":"array","minItems":1,"items":{"type":"integer","minimum":103,"maximum":105}},
    "sourcePagesPrinted":{"type":"array","items":{"type":"integer","minimum":89,"maximum":91}},
    "lemmaFormsRaw":{"type":"array","minItems":1,"items":{"type":"string"}},
    "sourceGlossRaw":{"type":"string"},
    "numberDistributionRaw":{"type":["object","null"],"additionalProperties":true},
    "paradigmAvailabilityRaw":{"type":["object","null"],"additionalProperties":true},
    "sourceDescription":{"type":"string"},
    "examplesRaw":{"type":"array","items":{"type":"string"}},
    "editorialCaution":{"type":["string","null"]},
    "reviewStatus":{"type":"string","enum":["machine_corrected_unverified","editorial_proposal","human_verified","unresolved"]},
    "humanVerified":{"type":"boolean"},
    "provenance":{"type":"object","required":["derivedFrom","agent","method"],"properties":{"derivedFrom":{"type":"string"},"agent":{"type":"string"},"method":{"type":"string"},"processedAt":{"type":["string","null"],"format":"date-time"}},"additionalProperties":false}
  },
  "allOf":[
    {"if":{"properties":{"reviewStatus":{"const":"human_verified"}}},"then":{"properties":{"humanVerified":{"const":true}}}},
    {"if":{"properties":{"humanVerified":{"const":true}}},"then":{"properties":{"reviewStatus":{"const":"human_verified"}}}}
  ],
  "additionalProperties":false
}
