{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/fersandovalgtz/cahita-historico-digital/schemas/grammatical-paradigm.schema.json",
  "title":"CHD historical grammatical paradigm",
  "description":"A source-anchored representation of a paradigm or comparative table in ALC1737. Labels and analyses are preserved first as categories of the 1737 grammar; modern interpretation belongs in a separate layer.",
  "type":"object",
  "required":["id","sourceId","sourcePagesDigital","section","paradigmType","labelRaw","cells","reviewStatus","humanVerified","provenance"],
  "properties":{
    "id":{"type":"string","pattern":"^ALC1737-par-"},
    "sourceId":{"const":"ALC1737"},
    "sourcePagesDigital":{"type":"array","minItems":1,"items":{"type":"integer","minimum":1,"maximum":182}},
    "sourcePagesPrinted":{"type":"array","items":{"type":"integer","minimum":1,"maximum":118}},
    "section":{"type":"string","enum":["part_i","part_ii","part_iii","part_iv"]},
    "paradigmType":{"type":"string","enum":["conjugation","variety_comparison","declension","pronoun_paradigm","other"]},
    "labelRaw":{"type":"string"},
    "lemmaRaw":{"type":["string","null"]},
    "sourceClaim":{"type":["string","null"]},
    "cells":{
      "type":"array","minItems":1,
      "items":{
        "type":"object",
        "required":["grammaticalLabelsRaw","formRaw"],
        "properties":{
          "varietyRaw":{"type":["string","null"]},
          "grammaticalLabelsRaw":{"type":"array","items":{"type":"string"}},
          "formRaw":{"type":"string"},
          "glossRaw":{"type":["string","null"]},
          "note":{"type":["string","null"]},
          "cellStatus":{"type":"string","enum":["readable","uncertain","unresolved"]}
        },
        "additionalProperties":false
      }
    },
    "editorialInterpretation":{"type":["string","null"]},
    "caution":{"type":"string"},
    "reviewStatus":{"type":"string","enum":["machine_corrected_unverified","editorial_proposal","human_verified","unresolved"]},
    "humanVerified":{"type":"boolean"},
    "provenance":{"type":"object","required":["derivedFrom","agent","method"],"properties":{"derivedFrom":{"type":"string"},"agent":{"type":"string"},"method":{"type":"string"},"processedAt":{"type":["string","null"],"format":"date-time"}},"additionalProperties":false}
  },
  "allOf":[
    {"if":{"properties":{"reviewStatus":{"const":"human_verified"}}},"then":{"properties":{"humanVerified":{"const":true}}}},
    {"if":{"properties":{"humanVerified":{"const":true}}},"then":{"properties":{"reviewStatus":{"const":"human_verified"}}}}
  ],
  "additionalProperties":false
}
