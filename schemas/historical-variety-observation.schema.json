{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fersandovalgtz/cahita-historico-digital/schemas/historical-variety-observation.schema.json",
  "title": "CHD historical variety observation",
  "description": "Observation anchored in ALC1737 where the source explicitly attributes a linguistic form, contrast or usage to Hiaqui, Mayo/Mayes, Thehueco/Tehuecos or another historically named variety.",
  "type": "object",
  "required": ["id", "sourceId", "sourcePageDigital", "section", "varietiesRaw", "observationType", "sourceText", "reviewStatus", "humanVerified", "provenance"],
  "properties": {
    "id": {"type": "string", "pattern": "^ALC1737-var-[0-9]{4}$"},
    "sourceId": {"const": "ALC1737"},
    "sourcePageDigital": {"type": "integer", "minimum": 1, "maximum": 182},
    "sourcePagePrinted": {"type": ["integer", "null"], "minimum": 1, "maximum": 118},
    "section": {"type": "string", "enum": ["preliminaries", "part_i", "part_ii", "part_iii", "part_iv", "vocabulary", "numerals"]},
    "varietiesRaw": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "observationType": {"type": "string", "enum": ["metalinguistic_grouping", "phonological_or_morphophonological", "morphological", "pronominal", "lexical", "paradigm", "other_explicit_source_attribution"]},
    "phenomenon": {"type": ["string", "null"]},
    "sourceText": {"type": "string", "minLength": 1},
    "structuredClaim": {"type": ["object", "null"], "additionalProperties": true},
    "editorialInterpretation": {"type": ["string", "null"]},
    "caution": {"type": ["string", "null"]},
    "reviewStatus": {"type": "string", "enum": ["machine_corrected_unverified", "editorial_proposal", "human_verified", "unresolved"]},
    "humanVerified": {"type": "boolean"},
    "provenance": {
      "type": "object",
      "required": ["derivedFrom", "agent", "method"],
      "properties": {
        "derivedFrom": {"type": "string"},
        "agent": {"type": "string"},
        "method": {"type": "string"},
        "processedAt": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {"if": {"properties": {"reviewStatus": {"const": "human_verified"}}}, "then": {"properties": {"humanVerified": {"const": true}}}},
    {"if": {"properties": {"humanVerified": {"const": true}}}, "then": {"properties": {"reviewStatus": {"const": "human_verified"}}}}
  ],
  "additionalProperties": false
}
