{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/fersandovalgtz/cahita-historico-digital/schemas/nonfinite-construction.schema.json",
  "title":"CHD historical nonfinite construction",
  "description":"Representation of infinitive and gerund constructions as described in ALC1737 Part III. Historical categories and Latin labels are preserved before modern linguistic reinterpretation.",
  "type":"object",
  "required":["id","sourceId","part","constructionTypeRaw","sourcePagesDigital","sourcePagesPrinted","sourceRuleRange","sourceDescription","reviewStatus","humanVerified","provenance"],
  "properties":{
    "id":{"type":"string","pattern":"^ALC1737-nf-[0-9]{4}$"},
    "sourceId":{"const":"ALC1737"},
    "part":{"const":"part_iii"},
    "constructionTypeRaw":{"type":"string","enum":["infinitivo_primer_modo","infinitivo_segundo_modo","gerundio_en_di","gerundio_en_do","gerundio_en_dum"]},
    "sourcePagesDigital":{"type":"array","minItems":1,"items":{"type":"integer","minimum":69,"maximum":104}},
    "sourcePagesPrinted":{"type":"array","minItems":1,"items":{"type":"integer","minimum":55,"maximum":90}},
    "sourceRuleRange":{"type":"string"},
    "formationMarkersRaw":{"type":"array","items":{"type":"string"}},
    "voiceBehaviorRaw":{"type":["string","null"]},
    "subjectConfigurationRaw":{"type":["string","null"]},
    "sourceDescription":{"type":"string","minLength":1},
    "structuredDescription":{"type":["object","null"],"additionalProperties":true},
    "examplesRaw":{"type":"array","items":{"type":"string"}},
    "editorialCaution":{"type":["string","null"]},
    "reviewStatus":{"type":"string","enum":["machine_corrected_unverified","editorial_proposal","human_verified","unresolved"]},
    "humanVerified":{"type":"boolean"},
    "provenance":{"type":"object","required":["derivedFrom","agent","method"],"properties":{"derivedFrom":{"type":"string"},"agent":{"type":"string"},"method":{"type":"string"},"processedAt":{"type":["string","null"],"format":"date-time"}},"additionalProperties":false}
  },
  "allOf":[
    {"if":{"properties":{"reviewStatus":{"const":"human_verified"}}},"then":{"properties":{"humanVerified":{"const":true}}}},
    {"if":{"properties":{"humanVerified":{"const":true}}},"then":{"properties":{"reviewStatus":{"const":"human_verified"}}}}
  ],
  "additionalProperties":false
}
