{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fersandovalgtz/cahita-historico-digital/schemas/page-transcription.schema.json",
  "title": "CHD page transcription",
  "description": "Page-anchored transcription unit for ALC1737. Supports full-page or excerpt coverage and explicitly typed review status.",
  "type": "object",
  "required": [
    "sourceId", "sourcePageDigital", "section", "transcriptionType",
    "coverage", "text", "reviewStatus", "humanVerified", "provenance"
  ],
  "properties": {
    "sourceId": {"const": "ALC1737"},
    "sourcePageDigital": {"type": "integer", "minimum": 1, "maximum": 182},
    "sourcePagePrinted": {"type": ["integer", "null"], "minimum": 1, "maximum": 118},
    "section": {
      "type": "string",
      "enum": ["preliminaries", "part_i", "part_ii", "part_iii", "part_iv", "vocabulary", "numerals", "end_matter"]
    },
    "transcriptionType": {"const": "diplomatic"},
    "coverage": {"type": "string", "enum": ["full_page", "excerpt"]},
    "text": {"type": "string", "minLength": 1},
    "lineBreakPolicy": {"type": "string"},
    "reviewStatus": {
      "type": "string",
      "enum": ["machine_corrected_unverified", "editorial_proposal", "human_verified", "unresolved"]
    },
    "humanVerified": {"type": "boolean"},
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["token", "note"],
        "properties": {
          "token": {"type": "string"},
          "note": {"type": "string"},
          "line": {"type": ["integer", "null"], "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": ["derivedFrom", "agent", "method"],
      "properties": {
        "derivedFrom": {"type": "string"},
        "agent": {"type": "string"},
        "method": {"type": "string"},
        "processedAt": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"reviewStatus": {"const": "human_verified"}}},
      "then": {"properties": {"humanVerified": {"const": true}}}
    },
    {
      "if": {"properties": {"humanVerified": {"const": true}}},
      "then": {"properties": {"reviewStatus": {"const": "human_verified"}}}
    }
  ],
  "additionalProperties": false
}
