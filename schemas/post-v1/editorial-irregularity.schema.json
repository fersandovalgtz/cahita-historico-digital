{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fersandovalgtz/cahita-historico-digital/schemas/post-v1/editorial-irregularity.schema.json",
  "title": "CHD post-v1 editorial irregularity record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "sourceId",
    "category",
    "title",
    "sourcePagesDigital",
    "sourcePagesPrinted",
    "evidenceFiles",
    "sourceText",
    "evidence",
    "editorialTreatment",
    "structuredData",
    "authority",
    "reviewStatus",
    "humanVerified"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^ALC1737-irreg-[a-z0-9-]+$"},
    "sourceId": {"const": "ALC1737"},
    "category": {
      "enum": [
        "structural_self_description_conflict",
        "printed_number_omission",
        "printed_number_repetition",
        "intra_page_section_boundary",
        "ocr_facsimile_disagreement"
      ]
    },
    "title": {"type": "string", "minLength": 1},
    "sourcePagesDigital": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 182}
    },
    "sourcePagesPrinted": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 118}
    },
    "evidenceFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "sourceText": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence": {"type": "string", "minLength": 1},
    "editorialTreatment": {"type": "string", "minLength": 1},
    "structuredData": {"type": "object"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceDescriptionPreserved",
        "silentNormalizationPerformed",
        "silentRenumberingPerformed",
        "modernLinguisticInferencePerformed"
      ],
      "properties": {
        "sourceDescriptionPreserved": {"const": true},
        "silentNormalizationPerformed": {"const": false},
        "silentRenumberingPerformed": {"const": false},
        "modernLinguisticInferencePerformed": {"const": false}
      }
    },
    "reviewStatus": {"enum": ["machine_corrected_unverified", "unresolved"]},
    "humanVerified": {"const": false}
  }
}
