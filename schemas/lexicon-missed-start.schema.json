{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fersandovalgtz/cahita-historico-digital/schemas/lexicon-missed-start.schema.json",
  "title": "CHD visually observed article start missed by candidate extractor",
  "description": "Records a visible historical article start that is not represented by its own canonical v0.2 boundary candidate. These records measure false negatives separately from candidate reconciliation.",
  "type": "object",
  "required": [
    "missedStartId", "sourceId", "sourcePageDigital", "column",
    "visibleStartRaw", "missType", "reviewStatus", "humanVerified", "provenance"
  ],
  "properties": {
    "missedStartId": {"type": "string", "pattern": "^ALC1737-miss-p[0-9]{3}-[LR]-[0-9]{3}$"},
    "sourceId": {"const": "ALC1737"},
    "sourcePageDigital": {"type": "integer", "minimum": 133, "maximum": 177},
    "column": {"type": "string", "enum": ["left", "right"]},
    "visibleStartRaw": {"type": "string", "minLength": 1},
    "missType": {"type": "string", "enum": ["inside_candidate_group", "between_candidates", "page_or_column_edge", "other"]},
    "containingCandidateId": {"type": ["string", "null"], "pattern": "^ALC1737-vcand-p[0-9]{3}-[LR]-[0-9]{3}$"},
    "linkedArticleIds": {
      "type": "array",
      "items": {"type": "string", "pattern": "^ALC1737-art-[0-9]{6}$"},
      "uniqueItems": true
    },
    "editorialNote": {"type": ["string", "null"]},
    "reviewStatus": {"type": "string", "enum": ["machine_corrected_unverified", "human_verified", "unresolved"]},
    "humanVerified": {"type": "boolean"},
    "provenance": {
      "type": "object",
      "required": ["agent", "method"],
      "properties": {
        "agent": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "processedAt": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"reviewStatus": {"const": "human_verified"}}},
      "then": {"properties": {"humanVerified": {"const": true}}}
    },
    {
      "if": {"properties": {"humanVerified": {"const": true}}},
      "then": {"properties": {"reviewStatus": {"const": "human_verified"}}}
    }
  ],
  "additionalProperties": false
}
