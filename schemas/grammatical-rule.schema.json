{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fersandovalgtz/cahita-historico-digital/schemas/grammatical-rule.schema.json",
  "title": "CHD historical grammatical rule",
  "description": "Structured representation of a numbered or otherwise delimited grammatical rule in ALC1737. It preserves source wording and keeps CHD analysis separate from the historical description.",
  "type": "object",
  "required": ["id", "sourceId", "sourcePageDigital", "sourcePagePrinted", "part", "ruleNumberRaw", "topic", "sourceExcerpt", "reviewStatus", "humanVerified", "provenance"],
  "properties": {
    "id": {"type": "string", "pattern": "^ALC1737-gr-[0-9]{4}$"},
    "sourceId": {"const": "ALC1737"},
    "sourcePageDigital": {"type": "integer", "minimum": 15, "maximum": 132},
    "sourcePagePrinted": {"type": "integer", "minimum": 1, "maximum": 118},
    "part": {"type": "string", "enum": ["part_i", "part_ii", "part_iii", "part_iv"]},
    "subsectionRaw": {"type": ["string", "null"]},
    "ruleNumberRaw": {"type": "string", "minLength": 1},
    "ruleNumberNumeric": {"type": ["integer", "null"], "minimum": 1},
    "topic": {"type": "string", "minLength": 1},
    "phenomenonType": {"type": "string", "enum": ["morphology", "morphophonology", "syntax", "lexicon", "word_formation", "paradigm", "metalinguistic", "other"]},
    "sourceExcerpt": {"type": "string", "minLength": 1},
    "structuredDescription": {"type": ["object", "null"], "additionalProperties": true},
    "examplesRaw": {"type": "array", "items": {"type": "string"}},
    "historicalVarietyObservationIds": {"type": "array", "items": {"type": "string", "pattern": "^ALC1737-var-[0-9]{4}$"}},
    "editorialNote": {"type": ["string", "null"]},
    "reviewStatus": {"type": "string", "enum": ["machine_corrected_unverified", "editorial_proposal", "human_verified", "unresolved"]},
    "humanVerified": {"type": "boolean"},
    "provenance": {
      "type": "object",
      "required": ["derivedFrom", "agent", "method"],
      "properties": {
        "derivedFrom": {"type": "string"},
        "agent": {"type": "string"},
        "method": {"type": "string"},
        "processedAt": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {"if": {"properties": {"reviewStatus": {"const": "human_verified"}}}, "then": {"properties": {"humanVerified": {"const": true}}}},
    {"if": {"properties": {"humanVerified": {"const": true}}}, "then": {"properties": {"reviewStatus": {"const": "human_verified"}}}}
  ],
  "additionalProperties": false
}
