{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fersandovalgtz/cahita-historico-digital/schemas/lexicon-candidate-review.schema.json",
  "title": "CHD lexicon candidate reconciliation record",
  "description": "Editorial review record that classifies one machine-generated vocabulary boundary candidate without promoting it automatically to a historical lexical article.",
  "type": "object",
  "required": [
    "candidateId", "sourceId", "sourcePageDigital", "classification",
    "boundaryAssessment", "linkedArticleIds", "reviewStatus", "humanVerified", "provenance"
  ],
  "properties": {
    "candidateId": {
      "type": "string",
      "pattern": "^ALC1737-vcand-p[0-9]{3}-[LR]-[0-9]{3}$"
    },
    "sourceId": {"const": "ALC1737"},
    "sourcePageDigital": {"type": "integer", "minimum": 133, "maximum": 177},
    "column": {"type": ["string", "null"], "enum": ["left", "right", null]},
    "classification": {
      "type": "string",
      "enum": ["article", "paratext", "continuation", "false_positive", "unresolved"]
    },
    "boundaryAssessment": {
      "type": "string",
      "enum": ["exact", "oversegmented", "undersegmented", "merged_articles", "ambiguous", "not_applicable"]
    },
    "linkedArticleIds": {
      "type": "array",
      "items": {"type": "string", "pattern": "^ALC1737-art-[0-9]{6}$"},
      "uniqueItems": true
    },
    "paratextType": {
      "type": ["string", "null"],
      "enum": ["catchword", "header", "page_number", "section_heading", "column_artifact", "other", null]
    },
    "continuationType": {
      "type": ["string", "null"],
      "enum": ["from_previous_line", "from_previous_column", "from_previous_page", "to_next_column", "to_next_page", "other", null]
    },
    "evidenceRaw": {"type": ["string", "null"]},
    "editorialNote": {"type": ["string", "null"]},
    "reviewStatus": {
      "type": "string",
      "enum": ["machine_corrected_unverified", "editorial_proposal", "human_verified", "unresolved"]
    },
    "humanVerified": {"type": "boolean"},
    "provenance": {
      "type": "object",
      "required": ["derivedFrom", "agent", "method"],
      "properties": {
        "derivedFrom": {"type": "string", "minLength": 1},
        "agent": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "processedAt": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"classification": {"const": "article"}}},
      "then": {"properties": {"linkedArticleIds": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"classification": {"const": "paratext"}}},
      "then": {"required": ["paratextType"]}
    },
    {
      "if": {"properties": {"classification": {"const": "continuation"}}},
      "then": {"required": ["continuationType"]}
    },
    {
      "if": {"properties": {"reviewStatus": {"const": "human_verified"}}},
      "then": {"properties": {"humanVerified": {"const": true}}}
    },
    {
      "if": {"properties": {"humanVerified": {"const": true}}},
      "then": {"properties": {"reviewStatus": {"const": "human_verified"}}}
    }
  ],
  "additionalProperties": false
}
